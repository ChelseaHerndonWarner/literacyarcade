rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isKnownStripePrice(priceId) {
      return [
        'price_1TqmEK3PzX3bHrbQEkK6vaes',
        'price_1TqmEJ3PzX3bHrbQ2cWDevb5',
        'price_1TqmEM3PzX3bHrbQh3wylsSF',
        'price_1TqY6k4Gz51pZDtQR6oFrYDp',
        'price_1TqY5P4Gz51pZDtQOiymXQZ4',
        'price_1TqY444Gz51pZDtQmTMOq3Gv',
        'price_1TssAC3PzX3bHrbQg4qIhxOH'
      ].hasAny([priceId]);
    }

    // A Free account that has used all 5 lifetime creation credits (activitiesCreated >= 5) has
    // read-only saved activities: it can still open, play, share and delete them, but cannot
    // change their content. Plus/Family accounts, and accounts with no counter yet, are never locked.
    // Mirrors effectivePlan() in functions/entitlements.js: a manual grant that has ended counts
    // only for what remains after it, even before the server has rewritten the user document.
    function hasPaidPlan(user) {
      return user.get('plan', 'free') in ['plus', 'family']
        && (!('planExpiresAt' in user)
          || (user.planExpiresAt is timestamp && user.planExpiresAt > request.time)
          || user.get('planAfterExpiry', 'free') in ['plus', 'family']);
    }

    function isEditLocked(uid) {
      let userPath = /databases/$(database)/documents/users/$(uid);
      return exists(userPath)
        && !hasPaidPlan(get(userPath).data)
        && get(userPath).data.get('activitiesCreated', 0) >= 5;
    }

    // Plan and quota fields on users/{uid} are written only by server code.
    function serverOnlyUserFields() {
      return ['plan', 'planSource', 'planUpdatedAt', 'planExpiresAt', 'planAfterExpiry',
        'stripePriceId', 'stripeSubscriptionId', 'stripeStatus', 'assessmentUses', 'activitiesCreated'];
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;

      allow create: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.keys().hasAny(serverOnlyUserFields());

      allow update: if request.auth != null
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields());
    }

    // Manual Plus / Plus Family grants. Administrators only (console or Admin SDK).
    match /planGrants/{userId} {
      allow read, write: if false;
    }

    // Saved activities. Clients may read and delete their own, and edit them unless the account is
    // read-only (see isEditLocked). They can never create: new activities are created only by the
    // createActivity Cloud Function (Admin SDK, which bypasses these rules) so the Free-plan
    // lifetime creation limit is enforced atomically. Share fields are also written server-side
    // (shareActivity / createActivity), so locking edits does not block sharing.
    match /users/{userId}/activities/{activityId} {
      allow get, list: if request.auth != null
        && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && !isEditLocked(userId);
      allow create: if false;
      // Deleting here must also revoke every shared link this activity ever produced, atomically,
      // so the client only learns "deleted" once access is actually gone — a plain client delete
      // can't guarantee that (an async cleanup trigger is a fallback, not a synchronous guarantee).
      // deleteActivityAndLinks (Admin SDK, bypasses these rules) is the only deletion path now;
      // confirmed before this rule changed that teacher-dashboard.html's deleteActivity() was the
      // only direct client delete anywhere in the codebase, and it now calls that function instead.
      allow delete: if false;
    }

    // Assessment-completion history (assessment type + timestamp only, no
    // student data). Written only by the recordAssessmentCompletion Cloud
    // Function via the Admin SDK, which bypasses these rules entirely, so
    // clients get no read or write access here.
    match /users/{userId}/assessmentHistory/{historyId} {
      allow read, write: if false;
    }

    // Free-plan lifetime activity-creation log (one doc per created activity).
    // Written only by the createActivity Cloud Function via the Admin SDK;
    // users/{uid}.activitiesCreated is protected above for the same reason.
    match /users/{userId}/creationHistory/{activityId} {
      allow read, write: if false;
    }

    match /users/{userId}/collections/{collectionId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/lessons/{lessonId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    match /sharedActivities/{shareId} {
      // Share links are created only by the createActivity and shareActivity Cloud Functions, so a
      // direct client write cannot publish a new shared game (e.g. past the Free creation limit).
      // Students keep reading existing links; owners can still delete (revoke) their own.
      //
      // Expiration (expiresAt) is enforced here, not just hidden in the frontend: a link minted
      // before this field existed has no expiresAt at all, and the missing-field case below keeps
      // it working forever, exactly like before this feature shipped (no backfill, no behavior
      // change for legacy links). A link past its expiresAt denies the read the same way a
      // deleted/revoked one does (the document may still exist but reads as "not found" to an
      // anonymous client either way) — by design, so no extra information is leaked about why a
      // given link stopped working.
      allow get: if resource.data.public == true
        && (!('expiresAt' in resource.data) || resource.data.expiresAt > request.time);
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.ownerUid;
    }

    // Firebase Stripe Payments extension paths.
    // Clients may create checkout sessions for their own account, then read
    // extension-created subscription/payment records. Clients must never write
    // subscription/payment/product records or users/{uid}.plan.
    match /customers/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      match /checkout_sessions/{sessionId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'price',
            'success_url',
            'cancel_url',
            'allow_promotion_codes',
            'metadata'
          ])
          && isKnownStripePrice(request.resource.data.price);
        allow update, delete: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }

      match /payments/{paymentId} {
        allow read: if request.auth != null
          && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /products/{productId} {
      allow read: if true;

      match /prices/{priceId} {
        allow read: if true;
      }
    }
  }
}
